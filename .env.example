# ─────────────────────────── Model ───────────────────────────
# real = call a model through any OpenAI-compatible API. mock = canned answers (UI work, zero cost)
FIRSTCALL_LLM=real
# Key from backend/app/models.yaml ("qwen3-30b", "qwen3-235b", "gpt-oss-120b", "cascade")
# or provider:model-id for anything else ("groq:openai/gpt-oss-20b")
FIRSTCALL_DEFAULT_MODEL=qwen3-30b

# Nebius Token Factory: the engine. $1 trial credit on sign-up ≈ 3,000 diagnoses on qwen3-30b
NEBIUS_API_KEY=
# Free fallbacks: Groq (set FIRSTCALL_AUTO_INVESTIGATE=0, 8k tokens/min) and Cerebras ($5 trial)
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Ollama (local, only on a machine with RAM to spare)
OLLAMA_BASE_URL=http://localhost:11434/v1/
# OpenRouter (cheap hosted open models for testing)
OPENROUTER_API_KEY=
# Anything else OpenAI-compatible (vLLM, LM Studio, llama.cpp server, Groq...)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ─────────────────────────── Cluster ───────────────────────────
# cluster = live cluster from your kubeconfig. fixtures = recorded snapshots (offline demo)
FIRSTCALL_SOURCE=cluster
# Comma list, or * for every non-system namespace
FIRSTCALL_NAMESPACES=firstcall-demo
FIRSTCALL_LOG_TAIL=80
# KUBECONFIG=/home/you/.kube/config   (defaults to ~/.kube/config)
KUBECTL_BIN=kubectl

# ─────────────────────────── Product loop ───────────────────────────
FIRSTCALL_WATCH=true
FIRSTCALL_WATCH_INTERVAL=15
FIRSTCALL_AUTO_DIAGNOSE=true
# Read-only follow-up commands FirstCall may run on its own after the first diagnosis (0 = never)
FIRSTCALL_AUTO_INVESTIGATE=1
# Healthy scans in a row before an incident is marked resolved
FIRSTCALL_RESOLVE_AFTER=2
# Human-approved fixes: off | approve. With approve, a proposed fix (rollout undo, set image, set resources,
# scale, patch on a Deployment/Service in a watched namespace) can be dry-run and applied after you click
# Approve in the console or on Telegram. Nothing is ever applied without a person.
FIRSTCALL_REMEDIATION=approve
# Post each diagnosis as a Kubernetes Event on the broken workload (kubectl describe shows it)
FIRSTCALL_WRITE_EVENTS=true
# ─────────────────────────── Paging (Telegram / Slack) ───────────────────────────
# always   = push every alert 24/7 (default)
# offhours = push only weekdays 17:00-09:00 and all weekend (at the desk you watch the console)
# Can be switched at runtime from the UI, the API or Telegram (/mode offhours)
FIRSTCALL_ALERT_MODE=always
FIRSTCALL_TIMEZONE=Europe/Amsterdam
FIRSTCALL_BUSINESS_START=09:00
FIRSTCALL_BUSINESS_END=17:00
FIRSTCALL_BUSINESS_DAYS=mon-fri
# Telegram: @BotFather -> /newbot -> token here. Start FirstCall, send /start to the bot, put the chat id below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Slack incoming webhook (optional)
SLACK_WEBHOOK_URL=
FIRSTCALL_PUBLIC_URL=http://localhost:3000

# ─────────────────────────── Web search (Tavily) ───────────────────────────
# When the model is unsure, search public sources for the ERROR TEXT ONLY (no names, IPs or logs)
# and re-ask with citations.  off | low-confidence | always
TAVILY_API_KEY=
FIRSTCALL_WEB_SEARCH=low-confidence
FIRSTCALL_WEB_SEARCH_THRESHOLD=0.6

# ─────────────────────────── Voice alerts (ElevenLabs) ───────────────────────────
# Sends the alert as a Telegram voice note as well: at 3am you hear it without unlocking the phone.
ELEVENLABS_API_KEY=
FIRSTCALL_VOICE_ALERTS=false
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─────────────────────────── Benchmark only (closed-model reference) ───────────────────────────
BASELINE_OPENAI_API_KEY=
BASELINE_OPENAI_MODEL=gpt-4.1-mini        # comma list = one reference row per model
BASELINE_ANTHROPIC_API_KEY=
# blank = ask the API for the newest sonnet. Comma list = one reference row per model,
# e.g. BASELINE_ANTHROPIC_MODEL=claude-sonnet-5,claude-haiku-4-5
BASELINE_ANTHROPIC_MODEL=

# k8sgpt baseline in the benchmark (bench-k8sgpt): which backend k8sgpt uses
K8SGPT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
K8SGPT_BASEURL=https://api.tokenfactory.nebius.com/v1/

# UI -> API (the UI proxies /fc/* to this)
FIRSTCALL_API_URL=http://localhost:8000

# Closed-baseline list prices (USD per 1M tokens). Leave blank and the benchmark reports
# their cost as n/a instead of a misleading $0.00 - they are not in models.yaml.
BASELINE_ANTHROPIC_PRICE_IN=
BASELINE_ANTHROPIC_PRICE_OUT=
BASELINE_OPENAI_PRICE_IN=
BASELINE_OPENAI_PRICE_OUT=
